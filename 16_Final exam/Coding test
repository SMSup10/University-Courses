1. 상속

#include<iostream>
using namespace std;

class CPoly {
protected:
    int w, h;
public:
    CPoly(int w, int h) : w(w), h(h) {}
    virtual void Area() {
        cout << "CPoly" << endl;
    }
    virtual ~CPoly() {}
};

class CRect : public CPoly {
public:
    CRect(int w, int h) : CPoly(w, h) {}
    void Area() override {
        cout << "Rect: " << w * h << endl;
    }
};

int main() {
    CRect r(2, 3);
    r.Area();
    
    CPoly* p = &r;
    p->Area();
    
    return 0;
}
2. 람다함수

#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
    vector<int> num = { 3, 1, 5, 2, 4 };

    // 람다 함수를 이용한 오름차순 정렬
    sort(num.begin(), num.end(),
        [](int a, int b) {
            return a < b;
        });

    for (int n : num)
        cout << n << " ";

    return 0;
}
